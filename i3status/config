general {
    colors = true
    interval = 5
}

order += "battery 1"
order += "tztime local"

battery 1 {
    path = "/sys/class/power_supply/BAT1/uevent"

    format = "%status %percentage"
    format_down = " N/A"

    status_chr = ""
    status_bat = ""
    status_full = ""

    last_full_capacity = true

    low_threshold = 15
    threshold_type = "percentage"
}

tztime local {
    format = "󰥔 %H:%M"
}
